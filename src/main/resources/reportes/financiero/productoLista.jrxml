	<queryString language="SQL">
		<![CDATA[select c.descripcion as catalogo, p.* from capacitacion.producto p 
join capacitacion.catalogo c on p.id_catalogo = c.id 
where p.stock != 0
and p.estado =   $P{estado} 
and c.id =  $P{catalogo}]]>
	</queryString>
