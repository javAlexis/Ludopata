	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LOCAL-CAPACITACION"/>
	<parameter name="catalogo" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select c.descripcion as catalogo, p.* from capacitacion.producto p 
join capacitacion.catalogo c on p.id_catalogo = c.id 
where p.stock != 0
and c.id = $P{catalogo} 
and p.estado = 'ACTIVO']]>
	</queryString>
