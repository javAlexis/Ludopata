 `Controllers/CuentasController.cs`

using Microsoft.AspNetCore.Mvc;
using CoacVirgenCisne.Api.DTOs;
using CoacVirgenCisne.Api.Services;

namespace CoacVirgenCisne.Api.Controllers;

[ApiController]
[Route("api/[controller]")]
public class CuentasController : ControllerBase
{
    private readonly CuentaService _service;

    public CuentasController(CuentaService service)
    {
        _service = service;
    }

    [HttpGet("{numero}")]
    public async Task<IActionResult> GetCuenta(string numero)
    {
        var cuenta = await _service.ObtenerCuentaAsync(numero);
        if (cuenta == null)
            return NotFound(new { mensaje = "La cuenta no existe." });

        return Ok(cuenta);
    }

    [HttpPost("{numero}/depositos")]
    public async Task<IActionResult> Depositar(string numero, [FromBody] OperacionDto dto)
    {
        var (status, resultado) = await _service.ProcesarOperacionAsync(numero, dto.Monto, "Deposito");
        return StatusCode(status, resultado);
    }

    [HttpPost("{numero}/retiros")]
    public async Task<IActionResult> Retirar(string numero, [FromBody] OperacionDto dto)
    {
        var (status, resultado) = await _service.ProcesarOperacionAsync(numero, dto.Monto, "Retiro");
        return StatusCode(status, resultado);
    }

    [HttpGet("{numero}/movimientos")]
    public async Task<IActionResult> GetMovimientos(string numero, [FromQuery] DateTime? desde, [FromQuery] DateTime? hasta)
    {
        var (status, resultado) = await _service.ListarMovimientosAsync(numero, desde, hasta);
        return StatusCode(status, resultado);
    }
}

