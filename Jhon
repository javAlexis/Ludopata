#### `Services/CuentaService.cs`

using Microsoft.EntityFrameworkCore;
using CoacVirgenCisne.Api.Data;
using CoacVirgenCisne.Api.Models;

namespace CoacVirgenCisne.Api.Services;

public class CuentaService
{
    private readonly AppDbContext _context;

    public CuentaService(AppDbContext context)
    {
        _context = context;
    }

    public async Task<object?> ObtenerCuentaAsync(string numero)
    {
        return await _context.Cuentas
            .Where(c => c.NumeroCuenta == numero)
            .Select(c => new { c.NumeroCuenta, c.Titular, c.Saldo, c.Estado })
            .FirstOrDefaultAsync();
    }

    public async Task<(int StatusCode, object Resultado)> ProcesarOperacionAsync(string numero, decimal monto, string tipo)
    {
        if (monto <= 0)
            return (400, new { mensaje = "El monto debe ser mayor a cero." });

        var cuenta = await _context.Cuentas.FirstOrDefaultAsync(c => c.NumeroCuenta == numero);

        if (cuenta == null)
            return (404, new { mensaje = "La cuenta no existe." });

        if (cuenta.Estado != "Activa")
            return (400, new { mensaje = "La cuenta se encuentra bloqueada." });

        if (tipo == "Retiro" && cuenta.Saldo < monto)
            return (400, new { mensaje = "Saldo insuficiente." });

        await using var transaction = await _context.Database.BeginTransactionAsync();
        try
        {
            cuenta.Saldo = tipo == "Deposito" ? cuenta.Saldo + monto : cuenta.Saldo - monto;

            _context.Movimientos.Add(new Movimiento
            {
                CuentaId = cuenta.Id,
                Tipo = tipo,
                Monto = monto,
                Fecha = DateTime.Now
            });

            await _context.SaveChangesAsync();
            await transaction.CommitAsync();

            return (200, new
            {
                mensaje = $"{tipo} realizado con éxito.",
                numeroCuenta = cuenta.NumeroCuenta,
                nuevoSaldo = cuenta.Saldo
            });
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    }

    public async Task<(int StatusCode, object Resultado)> ListarMovimientosAsync(string numero, DateTime? desde, DateTime? hasta)
    {
        var cuenta = await _context.Cuentas.FirstOrDefaultAsync(c => c.NumeroCuenta == numero);
        if (cuenta == null)
            return (404, new { mensaje = "La cuenta no existe." });

        var query = _context.Movimientos.Where(m => m.CuentaId == cuenta.Id);

        if (desde.HasValue)
            query = query.Where(m => m.Fecha >= desde.Value);

        if (hasta.HasValue)
            query = query.Where(m => m.Fecha <= hasta.Value);

        var lista = await query
            .OrderByDescending(m => m.Fecha)
            .Select(m => new { m.Id, m.Tipo, m.Monto, m.Fecha })
            .ToListAsync();

        return (200, lista);
    }
}

